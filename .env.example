# RELIC Environment Configuration

# Server Engine Settings
PORT=3001
HOST=127.0.0.1
STORAGE_DIR=./data
TEMP_DIR=./tmp

# Client Frontend Settings
VITE_API_URL=http://127.0.0.1:3001

# Ingestion Constraints (Defaults enforce strict resource boundaries)
MAX_ARCHIVE_SIZE_BYTES=209715200   # 200 MB
MAX_EXPANDED_SIZE_BYTES=524288000  # 500 MB
MAX_FILE_COUNT=10000               # 10,000 files
MAX_SINGLE_FILE_BYTES=10485760     # 10 MB
MAX_NESTING_DEPTH=25               # 25 directory levels

# Local AI Synthesis (Ollama & Gemma)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_MS=60000


